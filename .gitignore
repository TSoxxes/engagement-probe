__pycache__/
*.py[cod]
results/*
!results/.gitkeep
!results/README.md

# Released Round 2 artifacts (see results/README.md). Everything needed to
# reproduce the published numbers is published here, including the activation
# tensor. The blinded judging packets and the raw per-pass judge transcripts
# stay local -- they are process material, not results.
!results/round2_main/
results/round2_main/*
!results/round2_main/validation_summary.json
!results/round2_main/run_round2/
results/round2_main/run_round2/*
!results/round2_main/run_round2/responses.jsonl
!results/round2_main/run_round2/activations.npz
!results/round2_main/run_round2/run_config.json
!results/round2_main/run_round2/analysis/
!results/round2_main/run_round2/judging_web/
results/round2_main/run_round2/judging_web/*
!results/round2_main/run_round2/judging_web/aggregated/
!results/round2_main/run_round2/judging_web/manifest.json
!results/round2_main/run_round2/judging_web/PROTOCOL_DEVIATIONS.md
!results/round2_main/run_round2/prompt_annotations/
results/round2_main/run_round2/prompt_annotations/*
!results/round2_main/run_round2/prompt_annotations/aggregated/
tests/smoke_fixture/
tests/smoke_output/
tests/judging_test_workspace/
.tmp/
# Local checkout of the separate GitHub Pages repository. Canonical report
# assets live in report/ and output/pdf/; see docs/public_report_publishing.md.
public-report-pages/
report/engagement_probe_report.html
report/engagement_probe_report_v2.html

# Funding-application and outreach drafts. These are private working documents
# (budgets, applicant details, post drafts) and are deliberately not published
# with the research code. They remain on disk locally.
docs/bluedot_*
docs/round_3_bluedot_*
